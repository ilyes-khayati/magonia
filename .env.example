# Google Cloud project with Earth Engine enabled (https://code.earthengine.google.com)
EE_PROJECT=your-project-id
# Folder for the local database (optional, default ~/.magonia)
# MAGONIA_DATA_DIR=/path/to/folder
# Language model for the assistant: an Ollama server (default http://localhost:11434),
# or "scripted" for fixed answers without a model
# MAGONIA_MODEL_URL=http://192.168.0.10:11434
# MAGONIA_MODEL=qwen2.5:7b
# Contact address sent to OpenAlex with literature searches (optional; faster service)
# OPENALEX_EMAIL=you@example.org
# OpenAlex API key (free, from openalex.org). Without one, searches share a small daily
# budget with everyone on the same network, and stop until midnight UTC once it is used up.
# OPENALEX_API_KEY=your-key
